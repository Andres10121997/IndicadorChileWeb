@model IndicadorChileWeb.Models.SearchFilterModel
@{
    const string formID = "CurrencySearchForm";
}
@{
    Html.BeginForm(
        actionName: "Search",
        controllerName: "Currency",
        routeValues: new
        {
            @area = ""
        },
        method: FormMethod.Get,
        antiforgery: true,
        htmlAttributes: new
        {
            @autocomplete = "off",
            @class = "container",
            @id = formID,
            @name = formID,
            @role = "form"
        }
    );
        <fieldset form="@formID">
            <legend class="text-center">
                Buscar divisa
            </legend>

            <div class="row" role="row">
                <!-- Currency Type -->
                <div class="col-12">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.CurrencyType,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )
                        
                        @Html.DropDownListFor(
                            expression: model => model.CurrencyType,
                            selectList: @Html.GetEnumSelectList<Enums.currencyTypeEnum>(),
                            optionLabel: "- Selecciones una opción -",
                            htmlAttributes: new
                            {
                                @class = "form-control text-center",
                                @form = formID
                            }
                        )
                    </div>

                    @Html.ValidationMessageFor(
                        expression: model => model.CurrencyType
                    )
                </div>

                <!-- Year -->
                <div class="col-6">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.Year,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )

                        @Html.EditorFor(
                            expression: model => model.Year,
                            additionalViewData: new
                            {
                                htmlAttributes = new
                                {
                                    @autocomplete = "off",
                                    @class = "form-control text-center",
                                    @form = formID,
                                    @inputmode = "numeric"
                                }
                            }
                        )
                    </div>

                    @Html.ValidationMessageFor(
                        expression: model => model.Year
                    )
                </div>

                <!-- Month -->
                <div class="col-6">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.Month,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )

                        @Html.EditorFor(
                            expression: model => model.Month,
                            additionalViewData: new
                            {
                                htmlAttributes = new
                                {
                                    @autocomplete = "off",
                                    @class = "form-control text-center",
                                    @form = formID,
                                    @inputmode = "numeric"
                                }
                            }
                        )
                    </div>

                    @Html.ValidationMessageFor(
                        expression: model => model.Month
                    )
                </div>
            </div>

            <div class="row" role="row">
                <!-- Submit -->
                <div class="col-6">
                    <div class="d-grid gap-2 mb-3">
                        <button class="" form="@formID" role="button" title="Buscar información divisa" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                </div>

                <!-- Reset -->
                <div class="col-6">
                    <div class="d-grid gap-2 mb-3">
                        <button class="" form="@formID" role="button" title="Resetear formulario" type="reset">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                    </div>
                </div>
            </div>
        </fieldset>
    Html.EndForm();
}