@model IndicadorChileWeb.Models.SearchFilterModel
@{
    const string formID = "GetCurrencyForm";
}
@{
    Html.BeginForm(
        actionName: "",
        controllerName: "Currency",
        routeValues: new
        {
            @area = ""
        },
        method: FormMethod.Get,
        antiforgery: true,
        htmlAttributes: new
        {
            @autocomplete = "off",
            @class = "",
            @id = formID,
            @name = formID
        }
    );
        <fieldset form="@formID">
            <legend class="text-center">
                Buscar divisa
            </legend>

            <div class="row">
                <!-- Currency Type -->
                <div class="col-12">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.CurrencyType,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )
                        
                        @Html.DropDownListFor(
                            expression: model => model.CurrencyType,
                            selectList: @Html.GetEnumSelectList<Enums.currencyTypeEnum>(),
                            optionLabel: "- Selecciones una opción -",
                            htmlAttributes: new
                            {
                                @class = "form-control"
                            }
                        )
                    </div>

                    @Html.ValidationMessageFor(
                        expression: model => model.CurrencyType
                    )
                </div>

                <div class="col-6">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.Year,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )

                        @Html.EditorFor(
                            expression: model => model.Year,
                            additionalViewData: new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control"
                                }
                            }
                        )
                    </div>

                    @Html.ValidationMessageFor(
                        expression: model => model.Year
                    )
                </div>

                <div class="col-6">
                    <div class="input-group mb-3">
                        @Html.LabelFor(
                            expression: model => model.Month,
                            htmlAttributes: new
                            {
                                @class = "input-group-text"
                            }
                        )

                        @Html.EditorFor(
                            expression: model => model.Month,
                            additionalViewData: new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control"
                                }
                            }
                        )
                    </div>
                </div>
            </div>
        </fieldset>
    Html.EndForm();
}